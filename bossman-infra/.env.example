# ---------- compose ----------
COMPOSE_FILE=compose.yaml:compose.server.yaml   # сервер; на ноутбуке: compose.yaml
COMPOSE_PROFILES=local                           # local = поднимать llama-swap; пусто = только облачные модели
MODELS_DIR=/opt/bossman/models
LLAMA_SWAP_CONFIG=./llama-swap/config.yaml       # CPU-тест на ноутбуке: ./llama-swap/config-cpu.yaml
RENDER_GID=105                                   # getent group render | cut -d: -f3
VIDEO_GID=39                                     # getent group video  | cut -d: -f3

# ---------- секреты: openssl rand -hex 32 ----------
LITELLM_MASTER_KEY=sk-CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME

# ---------- облако (можно оставить пустым) ----------
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ---------- Open WebUI ----------
WEBUI_URL=https://bossman.TAILNET.ts.net          # адрес из `tailscale serve`
DEFAULT_MODEL=bossman-fast                        # на ноутбуке без GPU: claude-heavy
