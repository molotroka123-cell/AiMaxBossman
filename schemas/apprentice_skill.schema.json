{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bossman.local/schemas/apprentice_skill.schema.json",
  "title": "Universal Computer Apprentice memory record (episode | skill | lesson)",
  "description": "Validated with learning/trace.validate(case, schema=...) and stored through learning/trace.LearningStore. VERIFIED records need typed verifiers[] and evidence_records[] (same invariants as fix cases). Hidden reasoning, raw prompts and secrets are forbidden.",
  "type": "object",
  "x-forbidden-fields": [
    "chain_of_thought",
    "hidden_reasoning",
    "thoughts",
    "scratchpad",
    "raw_prompt",
    "raw_prompts",
    "cookies",
    "authorization",
    "password",
    "screenshot_bytes",
    "raw_log"
  ],
  "required": [
    "task_id",
    "record_type",
    "learning_status",
    "title",
    "environment",
    "agent",
    "model",
    "task_type"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "enum": [
        "episode",
        "skill",
        "lesson"
      ]
    },
    "learning_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "FAILED_EXPERIMENT",
        "PARTIAL",
        "UNVERIFIED",
        "REJECTED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "app": {
      "type": "string"
    },
    "app_version": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "principal_id": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "start_sha": {
      "type": "string"
    },
    "end_sha": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "skill_state": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "SHADOW",
        "READY",
        "DEGRADED",
        "ROLLED_BACK",
        "REJECTED"
      ]
    },
    "applicability": {
      "type": "object"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "semantic_anchors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expected_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_branches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rollback": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "verified_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "external_verification": {
      "type": "string"
    },
    "action_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checkpoints_reached": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lesson": {
      "type": "object"
    },
    "source_episode_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shadow_replays": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "degraded_reason": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "supersedes_version": {
      "type": "integer"
    },
    "tombstone": {
      "type": "boolean"
    },
    "superseded_by_version": {
      "type": "integer"
    },
    "verified": {
      "type": "boolean"
    }
  }
}
