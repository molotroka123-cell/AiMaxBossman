{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bossman.local/schemas/autonomy/task.schema.json",
  "title": "Bossman autonomy goal (bcc.autonomy.types.Goal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "problem", "desired_result", "constraints", "acceptance_tests", "budget", "risk_tier",
               "target_metric", "protected_metrics"],
  "properties": {
    "goal_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$", "maxLength": 64},
    "problem": {"type": "string", "minLength": 1, "maxLength": 4000},
    "desired_result": {"type": "string", "minLength": 1, "maxLength": 4000},
    "constraints": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "acceptance_tests": {"type": "array", "minItems": 1, "maxItems": 64,
                         "items": {"type": "string", "minLength": 3, "maxLength": 1000}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_minutes", "max_agent_turns", "max_cost_usd"],
      "properties": {
        "max_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
        "max_agent_turns": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 1000}
      }
    },
    "risk_tier": {"enum": ["docs_tests", "prompts_models", "memory_keys_telegram_services", "critical_runtime"]},
    "target_metric": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$", "maxLength": 128},
    "protected_metrics": {"type": "array", "maxItems": 64, "uniqueItems": true,
                          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
                                    "maxLength": 128}}
  }
}
