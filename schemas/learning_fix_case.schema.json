{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BossmanLearningFixCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "model",
    "agent",
    "start_sha",
    "end_sha",
    "task",
    "symptom",
    "reproduction",
    "evidence",
    "root_cause_hypotheses",
    "rejected_hypotheses",
    "root_cause",
    "relevant_code_paths",
    "fix_strategy",
    "alternatives_considered",
    "why_this_fix",
    "files_changed",
    "tests_added",
    "original_repro_result",
    "adversarial_variants",
    "regression_result",
    "external_verification",
    "generalizable_lessons",
    "teach_local_model",
    "confidence",
    "limitations",
    "verified_by",
    "learning_status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "start_sha": {
      "type": "string"
    },
    "end_sha": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "symptom": {
      "type": "string"
    },
    "reproduction": {
      "type": [
        "string",
        "array"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_cause_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_cause": {
      "type": "string"
    },
    "relevant_code_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fix_strategy": {
      "type": "string"
    },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "why_this_fix": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "original_repro_result": {
      "type": "string"
    },
    "adversarial_variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regression_result": {
      "type": "string"
    },
    "external_verification": {
      "type": "string"
    },
    "failure_recovery_lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generalizable_lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teach_local_model": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "FAILED_EXPERIMENT",
        "PARTIAL",
        "UNVERIFIED",
        "REJECTED"
      ]
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "bug_class": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ]
        },
        "security_boundary": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "FIXED",
        "BLOCKED_BY_DESIGN",
        "NOT_REPRODUCIBLE",
        "NOT_APPLICABLE",
        "ACCEPTED_RISK_REQUIRES_OWNER",
        "BLOCKED_ENV",
        "PARTIAL",
        "REJECTED"
      ]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "created_at": {
      "type": "string"
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principal_id",
          "independence_class"
        ],
        "properties": {
          "principal_id": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "independence_class": {
            "type": "string",
            "enum": [
              "same_run",
              "same_model",
              "cross_model",
              "external_tool",
              "human"
            ]
          }
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observed_at",
          "task_id",
          "source",
          "expected",
          "actual"
        ],
        "properties": {
          "observed_at": {
            "type": "number"
          },
          "collected_at": {
            "type": "number"
          },
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "principal_id": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "head_sha": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          }
        }
      }
    },
    "run_id": {
      "type": "string"
    },
    "principal_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_version": {
      "type": "integer",
      "minimum": 1
    },
    "tombstone": {
      "type": "boolean"
    },
    "superseded_by_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "x-forbidden-fields": [
    "chain_of_thought",
    "hidden_reasoning",
    "thoughts",
    "scratchpad",
    "raw_reasoning",
    "private_reasoning"
  ]
}
