{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bossman:mission-ir:1",
  "title": "Bossman Continuity Mission IR v1 candidate contract",
  "$comment": "Advisory structural schema; bossman_shared.mission_ir.MissionIR server validator is mandatory for finite numbers, canonical JSON types, bounded depth/bytes, DAG, unique effect IDs, prior revision chain, preservation of obligations and recovery cross-field bounds. A valid IR confers no authorization. Projection to BCC ExpectedState does not enforce the full IR.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
    },
    "side_effect": {
      "type": "boolean"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
          },
          "kind": {
            "enum": [
              "READ_ONLY",
              "IDEMPOTENT_WRITE",
              "REVERSIBLE_WRITE",
              "IRREVERSIBLE"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
            },
            "uniqueItems": true
          },
          "verifiers": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "file"
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
                    },
                    "expect": {
                      "type": "object",
                      "properties": {
                        "exists": {
                          "type": "boolean"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "contains": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
                        },
                        "min_bytes": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "additionalProperties": false,
                      "minProperties": 1,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "exists": {
                                "const": false
                              }
                            },
                            "required": [
                              "exists"
                            ]
                          },
                          "then": {
                            "maxProperties": 1
                          }
                        }
                      ]
                    },
                    "max_age_seconds": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 86400
                    }
                  },
                  "required": [
                    "kind",
                    "target",
                    "expect",
                    "max_age_seconds"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "app"
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
                    },
                    "expect": {
                      "type": "object",
                      "properties": {
                        "running": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false,
                      "minProperties": 1
                    },
                    "max_age_seconds": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 86400
                    }
                  },
                  "required": [
                    "kind",
                    "target",
                    "expect",
                    "max_age_seconds"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "process"
                    },
                    "target": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "expect": {
                      "type": "object",
                      "properties": {
                        "running": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false,
                      "minProperties": 1
                    },
                    "max_age_seconds": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 86400
                    }
                  },
                  "required": [
                    "kind",
                    "target",
                    "expect",
                    "max_age_seconds"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "effect_id",
          "kind",
          "description",
          "capabilities",
          "depends_on",
          "verifiers"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "privacy": {
      "enum": [
        "private",
        "local_only",
        "internal",
        "public"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "authorized_scope_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
      },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_wall_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "max_cost_usd",
        "max_tokens",
        "max_wall_seconds"
      ],
      "additionalProperties": false
    },
    "reservation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
      },
      "uniqueItems": true
    },
    "recovery": {
      "type": "object",
      "properties": {
        "max_attempts_per_effect": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_attempts_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "max_attempts_per_effect",
        "max_attempts_total"
      ],
      "additionalProperties": false
    },
    "success_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[^\\u0000]*\\S)?$"
        }
      },
      "required": [
        "source",
        "source_ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "project_id",
    "mission_id",
    "goal_id",
    "revision",
    "previous_digest",
    "goal",
    "side_effect",
    "effects",
    "privacy",
    "risk",
    "authorized_scope_refs",
    "budget",
    "reservation_refs",
    "recovery",
    "success_conditions",
    "artifact_refs",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "previous_digest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side_effect": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "effects": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "effects": {
            "items": {
              "properties": {
                "kind": {
                  "const": "READ_ONLY"
                }
              }
            }
          }
        }
      }
    }
  ]
}
