# BOSSMAN Social Farm — пример окружения.
# Скопируйте в .env и заполните. Файл .env в git не попадает (.gitignore).
#
# ПРАВИЛО: секрет живёт только в окружении или во внешнем хранилище.
# Ни один секрет не передаётся аргументом команды, не пишется в лог и не
# попадает в аудит — туда идёт ССЫЛКА на секрет, а не значение.

# ---------------------------------------------------------------- сервис
SF_HOST=127.0.0.1
SF_PORT=8895
SF_DATA_DIR=./data
SF_MEDIA_ROOT=./media

# ---------------------------------------------------------------- хранилище
# sqlite — по умолчанию и достаточно для 1–10 аккаунтов.
SF_DATABASE=sqlite
SF_DATABASE_URL=

# Ключ шифрования локального хранилища секретов. Пусто — будет создан при
# первом запуске в SF_DATA_DIR с правами 0600.
SF_VAULT_KEY=

# ---------------------------------------------------------------- Instagram (официальный API)
# Приложение Meta. Без них официальный адаптер работать не будет и честно
# скажет об этом, а не притворится работающим.
SF_META_APP_ID=
SF_META_APP_SECRET=
SF_META_REDIRECT_URI=http://127.0.0.1:8895/api/oauth/instagram/callback
# Версия Graph API фиксируется явно: провайдер меняет поведение между версиями.
SF_META_GRAPH_VERSION=v21.0
# Секрет для проверки подписи входящих webhook'ов.
SF_META_WEBHOOK_SECRET=
SF_META_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------- браузерный резерв
# Выключен по умолчанию. Включается явно и только для тех аккаунтов, где
# владелец это разрешил.
SF_BROWSER_FALLBACK=0
SF_BROWSER_HEADLESS=1
SF_BROWSER_CONTEXT_ROOT=./browser-contexts

# ---------------------------------------------------------------- генерация
# Провайдеры текста/изображений/видео. Пусто — генерация недоступна, и это
# показывается как NOT_SUPPORTED, а не как ошибка.
SF_GEN_TEXT_URL=
SF_GEN_IMAGE_URL=
SF_GEN_VIDEO_URL=
# Локальные модели через BOSSMAN или OpenAI-совместимый сервер.
SF_GEN_LOCAL_BASE_URL=

# ---------------------------------------------------------------- мост BOSSMAN
# Токен, которым BOSSMAN аутентифицируется в этом приложении.
SF_BRIDGE_TOKEN=

# ---------------------------------------------------------------- медиа
# ffmpeg/ffprobe для проверки и перекодирования. Нет их — медиа-конвейер
# сообщает NOT_SUPPORTED вместо публикации непроверенного файла.
SF_FFMPEG=ffmpeg
SF_FFPROBE=ffprobe
