# Пути привязаны к корню приложения (ведущий слэш) намеренно.
# Без него `media/` совпадал бы с ЛЮБЫМ каталогом с таким именем на любой
# глубине — включая исходный пакет src/social_farm/media/, и тот молча не
# попадал бы в репозиторий. Незакоммиченный код выглядит как написанный.
/data/
/media/
*.egg-info/
__pycache__/
.pytest_cache/
.venv/
.env
# Браузерные контексты аккаунтов: cookies и сессии живых людей.
# В git они не попадают ни при каких обстоятельствах.
/browser-contexts/
