# --- printer profile and data ------------------------------------------------
AI3D_PRINTER_PROFILE=./profiles/elegoo_neptune_3_plus.json
AI3D_MATERIAL_PROFILE=./profiles/material_defaults.json
AI3D_DATA_DIR=./data

# --- external tools (optional; the app reports NOT_AVAILABLE when missing) ----
AI3D_OPENSCAD_BIN=openscad
AI3D_CURAENGINE_BIN=CuraEngine
# Point this at the REAL ELEGOO Cura definition on the target machine.
# Never ship a fabricated vendor definition.
AI3D_CURA_DEFINITION=
AI3D_PRUSASLICER_BIN=prusa-slicer

# --- HTTP control surface -----------------------------------------------------
AI3D_HOST=127.0.0.1
AI3D_PORT=8890

# --- safety -------------------------------------------------------------------
AI3D_STRICT_GCODE=true

# Physical printing. Leaving this false is the safe default. Even when true, a
# physical action still requires the per-job human confirmation token.
AI3D_ALLOW_PHYSICAL_PRINT=false
# simulator | tf_card | usb_serial   (usb_serial is not implemented)
AI3D_PRINTER_TRANSPORT=simulator
AI3D_PRINTER_MEDIA_DIR=

# --- resource limits ----------------------------------------------------------
AI3D_JOB_TIMEOUT_S=120
AI3D_JOB_DISK_QUOTA_BYTES=268435456
AI3D_TOTAL_DISK_QUOTA_BYTES=4294967296
AI3D_MAX_UPLOAD_BYTES=134217728
AI3D_MAX_TRIANGLES=4000000
AI3D_MAX_JOBS_RETAINED=500
