# AI WebCam Vision — configuration. Every value is read at startup.
# Secrets come from the environment only; there is no CLI flag for them.

# --- identity -----------------------------------------------------------
AWV_ROOM_ID=dental-1

# --- camera -------------------------------------------------------------
# mock  : synthetic frames, no camera and no ffmpeg (default, clearly labelled)
# file  : local video fixture through the real ffmpeg transport
# rtsp  : real camera
AWV_CAMERA_MODE=mock
AWV_CAMERA_HOST=192.168.10.50
AWV_CAMERA_PORT=554
AWV_CAMERA_STREAM=stream2
AWV_CAMERA_USERNAME=camera_user
AWV_CAMERA_PASSWORD=
# AWV_CAMERA_FIXTURE=./fixtures/room.mp4

# --- external binaries --------------------------------------------------
# Discovery order: this value when it is not the bare default, then PATH,
# then AWV_FFMPEG, then the static binary shipped by imageio-ffmpeg. An
# explicit path here is never silently replaced by a fallback.
AWV_FFMPEG_PATH=ffmpeg
# AWV_FFMPEG=/opt/ffmpeg/bin/ffmpeg

# --- timeouts (seconds) -------------------------------------------------
AWV_CONNECT_TIMEOUT_SECONDS=8
AWV_CAPTURE_TIMEOUT_SECONDS=15
AWV_CRM_TIMEOUT_SECONDS=5
# A frame older than this describes the past; it is dropped, not analysed.
AWV_MAX_FRAME_AGE_SECONDS=30

# --- sampling and memory ------------------------------------------------
AWV_FRAME_WIDTH=160
AWV_FRAME_HEIGHT=90
AWV_ACTIVE_INTERVAL_SECONDS=1
AWV_IDLE_INTERVAL_SECONDS=10
AWV_MAX_SAMPLE_RATE_HZ=5
AWV_FRAME_QUEUE_MAX=8
AWV_MOTION_HOLD_SECONDS=90
# Run the persistent sampling loop, not only on-demand jobs.
AWV_RUNTIME_ENABLED=false

# --- reconnect ----------------------------------------------------------
AWV_RETRY_MAX_ATTEMPTS=5
AWV_RETRY_BASE_DELAY_SECONDS=0.5
AWV_RETRY_FACTOR=2
AWV_RETRY_MAX_DELAY_SECONDS=30

# --- analysis -----------------------------------------------------------
AWV_CHAIR_ZONE=0.25,0.25,0.78,0.90
AWV_WORK_ZONE=0.15,0.10,0.90,0.95
AWV_ROOM_THRESHOLD=0.035
AWV_CHAIR_THRESHOLD=0.055
AWV_WORK_THRESHOLD=0.012
AWV_DEBOUNCE_SAMPLES=2
# Temporal policy. Counting samples alone is not hysteresis: at 5 Hz two
# samples is 0.4 s, which is short enough to call a walk-through a procedure.
AWV_MIN_DWELL_SECONDS=6
AWV_CLINICAL_DWELL_SECONDS=30
AWV_TURNOVER_DWELL_SECONDS=15
AWV_TURNOVER_LOOKBACK_SECONDS=600
AWV_DROPOUT_GRACE_SECONDS=45

# --- privacy (deny by default) -----------------------------------------
AWV_SNAPSHOTS_ENABLED=false
AWV_SNAPSHOT_MAX_WIDTH=160
AWV_SNAPSHOT_BLUR_SIGMA=6
AWV_SNAPSHOT_RETENTION=20
AWV_TELEMETRY_ENABLED=false
AWV_CRM_EGRESS_ENABLED=false
# The next four are denied by design: setting them to true makes startup
# fail with privacy_denied. There is no implementation behind any of them,
# and a flag that is accepted but does nothing is worse than no flag.
AWV_RECORDING_ENABLED=false
AWV_CAPTURE_AUDIO=false
AWV_FACE_IDENTIFICATION=false
AWV_PATIENT_IDENTIFICATION=false

# --- CRM ----------------------------------------------------------------
# disabled | mock | generic_http
AWV_CRM_KIND=disabled
AWV_CRM_BASE_URL=
AWV_CRM_TOKEN=
AWV_CRM_RETRIES=3
AWV_CRM_RETRY_BASE_DELAY_SECONDS=0.25
# Older than this and an answer is marked stale (confidence drops);
# older than the hard limit and it stops counting as an answer at all.
AWV_CRM_MAX_AGE_SECONDS=300
AWV_CRM_HARD_MAX_AGE_SECONDS=3600

# --- storage ------------------------------------------------------------
AWV_STATE_DIR=./data
# The clinic's day is cut on this timezone's midnight, not on UTC midnight.
AWV_TIMEZONE=UTC

# --- service ------------------------------------------------------------
AWV_HOST=127.0.0.1
AWV_PORT=8870
AWV_API_TOKEN=
AWV_LOG_LEVEL=INFO
# AWV_LOG_FILE=./data/app.log
