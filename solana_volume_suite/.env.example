# Offline virtual-only build. Changing these flags to live values is blocked.
LIVE_EXECUTION_ENABLED=false
PAPER_TRADING=true
GEMINI_REAL_MONEY_READY=false
SOLANA_RPC_URL=mock://solana
SOLANA_WSS_URL=mock://solana
JITO_BLOCK_ENGINE_URL=mock://jito
MAX_ALLOWED_LOSS_USD=40

# Local dashboard credential only; never use a real provider API key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Or omit it and start_prototype.py generates a temporary token.
DASHBOARD_API_TOKEN=REPLACE_WITH_GENERATED_LOCAL_TOKEN
VAULT_MASTER_PASSWORD=REPLACE_WITH_GENERATED_MOCK_PASSWORD
