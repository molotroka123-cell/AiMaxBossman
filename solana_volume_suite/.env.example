# Режим исполнения
LIVE_EXECUTION_ENABLED=false   # false для Astra, true для Gemini
PAPER_TRADING=true             # true для Astra, false для Gemini
GEMINI_REAL_MONEY_READY=false  # false для Astra, true для Gemini

# Solana RPC (production)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Jito Block Engine
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_LAMPORTS=100000

# Бюджет и лимиты
MAX_ALLOWED_LOSS_USD=40.0
MAX_VOLUME_TARGET_USD=10000.0
MAX_PRICE_IMPACT_BPS=120

# Vault (сгенерируй новый пароль!)
VAULT_MASTER_PASSWORD=REPLACE_WITH_GENERATED_MOCK_PASSWORD

# Target Token (вставь реальный mint)
TARGET_TOKEN_MINT=DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263

# Local dashboard credential only; never use a real provider API key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=REPLACE_WITH_GENERATED_LOCAL_TOKEN
