+def test_every_failure_class_maps_to_a_typed_owner_visible_code():
+    """VS-DIAG-01: `executor failed: ValueError` is not a reason."""
+    from bcc.video_studio import diagnostics as d
+    cases = [
+        (asyncio.TimeoutError(), d.TIMEOUT),
+        (ValueError("export failed independent verification: duration mismatch"), d.VERIFIER_FAILED),
+        (ValueError("full decode failed"), d.MEDIA_DECODE_FAILED),
+        (ValueError("ffmpeg is unavailable; install a local FFmpeg build"), d.MISSING_FFMPEG),
+        (RuntimeError("insufficient disk space"), d.RESOURCE_EXHAUSTED),
+        (OSError(28, "No space left on device"), d.RESOURCE_EXHAUSTED),
+        (RuntimeError("Completion review is waiting for approval"), d.APPROVAL_REQUIRED),
+        (PermissionError("operation denied"), d.POLICY_DENIED),
+        (ValueError("export path already exists; use a new immutable artifact"), d.INVALID_PROJECT_STATE),
+        (Exception("something nobody predicted"), d.UNKNOWN),
+    ]
+    for exc, expected in cases:
+        assert d.classify(exc) == expected, (exc, d.classify(exc))
+        record = d.describe(exc)
+        assert record["reason_code"] in d.REASON_CODES
+        assert len(record["reason"]) <= d.MAX_MESSAGE
