+# ---------------------------------------------------------------------------
+# Bounded hashing. Whole-file SHA-256 used to run on the DEFAULT thread pool —
+# the one the whole Command Center shares — once per media reference, on every
+# HTTP GET. A large library therefore starved everything else, and one page of
+# thumbnails multiplied it by the number of sources on the page.
+#
+# Three bounds, none of which weakens the check itself:
+#   * a small DEDICATED pool, so hashing can never occupy shared workers;
+#   * a semaphore, so N concurrent requests cannot start N whole-file reads;
+#   * per-digest in-flight sharing, so identical concurrent requests hash once.
+# ---------------------------------------------------------------------------
+HASH_WORKERS = 2
+HASH_CONCURRENCY = 2
+IDENTITY_CACHE_LIMIT = 4096
+
+_hash_pool = None
+_gates: dict = {}          # event loop -> asyncio.Semaphore
+_inflight: dict = {}       # (loop id, digest) -> shared asyncio.Task
+# digest -> strong file identity accepted for that digest, see accept_identity().
+_verified_identity: "OrderedDict[str, tuple]" = OrderedDict()
+
+
+def hash_pool():
+    global _hash_pool
+    if _hash_pool is None:
+        _hash_pool = ThreadPoolExecutor(max_workers=HASH_WORKERS, thread_name_prefix="video-hash")
+    return _hash_pool
+
+
+def file_identity(path: Path) -> tuple:
+    """Strong-enough file identity: device, inode, size and mtime in nanoseconds.
+
+    HONEST LIMIT: this is identity, not content. A rewrite that lands on the SAME
+    inode with the SAME size and a deliberately restored mtime_ns is not detected
+    by it. Every ordinary mutation — write, truncate, append, copy, os.replace,
+    relink, restore from backup — changes at least one of the four. Content is
+    still proven by SHA-256 the first time each identity is seen, and again
+    whenever any component changes.
+    """
+    st = path.stat()
+    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
+
+
+def accept_identity(digest: str, identity: tuple) -> None:
+    _verified_identity[digest] = identity
+    _verified_identity.move_to_end(digest)
+    while len(_verified_identity) > IDENTITY_CACHE_LIMIT:
+        _verified_identity.popitem(last=False)
+
+
+def identity_is_verified(digest: str, identity: tuple) -> bool:
+    return _verified_identity.get(digest) == identity
+
+
+def forget_identity(digest: str | None = None) -> None:
+    """Drop cached acceptances; a relink or a failed check must not be sticky."""
+    if digest is None:
+        _verified_identity.clear()
+    else:
+        _verified_identity.pop(digest, None)
+
+
+async def hashed(path: Path) -> str:
+    """SHA-256 a whole file off the shared pool and under the concurrency bound."""
+    loop = asyncio.get_running_loop()
+    gate = _gates.get(id(loop))
+    if gate is None:
+        gate = _gates[id(loop)] = asyncio.Semaphore(HASH_CONCURRENCY)
+    async with gate:
+        return await loop.run_in_executor(hash_pool(), digest_file, Path(path))
+
+
