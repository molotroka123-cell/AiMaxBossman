+def test_identity_cache_states_exactly_what_it_guarantees(tmp_path):
+    """VS-HASH-01: the honest limit of (dev, ino, size, mtime_ns), in executable form.
+
+    A cached acceptance is bound to strong file identity, NOT to content. This
+    test pins the boundary so nobody later mistakes it for a content proof: a
+    same-inode, same-size rewrite whose mtime_ns is deliberately restored is the
+    one mutation the cache does not see, and every ordinary change is.
+    """
+    import os
+    from bcc.video_studio import media as media_module
+    media_module.forget_identity()
+    target = tmp_path / "payload.bin"
+    target.write_bytes(b"A" * 4096)
+    digest = media_module.digest_file(target)
+    before = media_module.file_identity(target)
+    media_module.accept_identity(digest, before)
+    assert media_module.identity_is_verified(digest, before)
+
+    stat = target.stat()
+    with target.open("r+b") as handle:
+        handle.seek(0)
+        handle.write(b"B" * 4096)
+    assert media_module.file_identity(target) != before          # mtime_ns moved: seen
+    os.utime(target, ns=(stat.st_atime_ns, stat.st_mtime_ns))
+    assert media_module.file_identity(target) == before          # restored: NOT seen
+    assert media_module.digest_file(target) != digest            # content really did change
+
+    # Any ordinary change is caught: size, inode and device all take part.
+    target.write_bytes(b"A" * 8192)
+    assert media_module.file_identity(target) != before
+
