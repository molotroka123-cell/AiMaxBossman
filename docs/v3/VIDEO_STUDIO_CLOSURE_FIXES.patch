+
+RECEIPT_VERSION = 1
+
+
+def receipt_for(path, verification, run_id):
+    """A durable record that THIS artifact was independently verified.
+
+    Produced by the executor, which owns the whole job lifetime, and consumed by
+    the completion gate, which does not: the gate runs under the engine's fixed
+    60 s critical-hook budget (engine.DEFAULT_HOOK_TIMEOUT_S — one constant for
+    every hook in the system, not raisable for this one). Re-decoding and
+    re-hashing a real export inside that budget is what made a finished, verified
+    export permanently undownloadable. The expensive proof therefore happens once,
+    where there is time for it, and the receipt is what survives.
+    """
+    from .media import file_identity
+    return {"version": RECEIPT_VERSION, "run_id": int(run_id), "path": str(path),
+            "sha256": verification.get("sha256"), "passed": verification.get("passed") is True,
+            "failures": list(verification.get("failures") or []),
+            "identity": list(file_identity(Path(path))), "checked_at": utcnow().isoformat()}
+
+
+def receipt_matches(receipt, path):
+    """Cheap, deterministic confirmation that the receipt still describes this file.
+
+    Strong file identity only: device, inode, size and mtime_ns. See
+    media.file_identity() for the exact guarantee — it is identity, not content,
+    and the content proof lives in the receipt that this identity is bound to.
+    """
+    from .media import file_identity
+    if not isinstance(receipt, dict) or receipt.get("version") != RECEIPT_VERSION:
+        return False, "verification receipt missing or of an unknown version"
+    if receipt.get("passed") is not True:
+        return False, "independent verification did not pass: " + ", ".join(receipt.get("failures") or ["unknown"])[:160]
+    if Path(receipt.get("path") or "") != Path(path):
+        return False, "verification receipt describes a different artifact"
+    try:
+        identity = list(file_identity(Path(path)))
+    except OSError:
+        return False, "verified artifact is no longer readable"
+    if identity != list(receipt.get("identity") or []):
+        return False, "verified artifact changed after verification"
+    return True, "durable independent verification receipt"
