+@needs_ffmpeg
+async def test_substituted_and_mutated_media_are_still_rejected(env, tmp_path, monkeypatch):
+    """VS-HASH-01: the identity cache must never accept content it has not proven."""
+    import os
+    from bcc.video_studio import media as media_module
+    media_module.forget_identity()
+    pid, project = await prepared_project(env, tmp_path, monkeypatch)
+    video = env.svc.video_studio
+    current = (await env.client.get(BASE + "/projects/" + pid)).json()
+    media = next(iter(current["media"].values()))
+    path = await video.media.verify(media)                 # proves content, caches identity
+    assert path.is_file()
+
+    # 1. Whole-file substitution through os.replace: a new inode.
+    replacement = fixture_clip(tmp_path / "other.mp4", colour="red", seconds=0.5)
+    os.replace(replacement, path)
+    with pytest.raises(ValueError):
+        await video.media.verify(media)
+
+    # 2. In-place rewrite that changes the size on the SAME inode.
+    media_module.forget_identity()
+    good = fixture_clip(tmp_path / "good.mp4", colour="blue", seconds=0.4)
+    path.write_bytes(good.read_bytes())
+    media = {**media, "sha256": media_module.digest_file(path)}
+    media["relative_path"] = str(path.relative_to(video.root))
+    path_name = path.with_name(media["sha256"] + path.suffix)
+    os.replace(path, path_name)
+    media["relative_path"] = str(path_name.relative_to(video.root))
+    assert await video.media.verify(media) == path_name
+    with path_name.open("r+b") as handle:
+        handle.seek(0, os.SEEK_END)
+        handle.write(b"tamper")
+    with pytest.raises(ValueError):
+        await video.media.verify(media)
+
+    # 3. Same-size in-place mutation on the same inode: mtime_ns moves, so the
+    #    content is re-hashed and the mismatch is caught.
+    media_module.forget_identity()
+    path_name.write_bytes(good.read_bytes())
+    assert await video.media.verify(media) == path_name
+    size = path_name.stat().st_size
+    with path_name.open("r+b") as handle:
+        handle.seek(size // 2)
+        handle.write(b"\x00\x01\x02\x03")
+    assert path_name.stat().st_size == size
+    with pytest.raises(ValueError):
+        await video.media.verify(media)
+
