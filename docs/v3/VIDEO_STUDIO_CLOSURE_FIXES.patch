+"""Structured, owner-visible failure reasons for Video Studio jobs.
+
+The engine records only `executor failed: <ExceptionClass>` (engine.py, not this
+subsystem's file to change), so a failed export used to be a black box: the
+owner saw a silent button and could not learn why. Every Video Studio executor
+now persists a typed reason code plus a redacted, bounded message next to the
+job, and the job API returns both.
+
+Nothing here emits secrets, environment, absolute host paths or a raw
+subprocess dump: `redact()` strips those before anything is stored.
+"""
+from __future__ import annotations
+
+import asyncio
+import re
+
+# The closed set of owner-visible reason codes. UNKNOWN is a real answer, not a
+# placeholder: it means "classified as nothing we recognise", and the redacted
+# message is still shown.
+TIMEOUT = "TIMEOUT"
+VERIFIER_FAILED = "VERIFIER_FAILED"
+MEDIA_DECODE_FAILED = "MEDIA_DECODE_FAILED"
+MISSING_FFMPEG = "MISSING_FFMPEG"
+RESOURCE_EXHAUSTED = "RESOURCE_EXHAUSTED"
+APPROVAL_REQUIRED = "APPROVAL_REQUIRED"
+POLICY_DENIED = "POLICY_DENIED"
+INVALID_PROJECT_STATE = "INVALID_PROJECT_STATE"
+UNKNOWN = "UNKNOWN"
+
+REASON_CODES = frozenset({TIMEOUT, VERIFIER_FAILED, MEDIA_DECODE_FAILED, MISSING_FFMPEG,
+                          RESOURCE_EXHAUSTED, APPROVAL_REQUIRED, POLICY_DENIED,
+                          INVALID_PROJECT_STATE, UNKNOWN})
+
+MAX_MESSAGE = 300
+
+_SECRETISH = re.compile(
+    r"(?i)\b(?:sk-|ghp_|gho_|github_pat_|xox[abprs]-|bearer\s+|api[-_ ]?key\s*[=:]\s*|token\s*[=:]\s*|password\s*[=:]\s*)\S+")
+# Absolute POSIX and Windows paths. Owned media is content-addressed, so the
+# only information a path carries is where this machine keeps its files.
+_ABSPATH = re.compile(r"(?:[A-Za-z]:)?[\\/](?:[\w.\-+]+[\\/]){1,}[\w.\-+]*")
+_LONGHEX = re.compile(r"\b[0-9a-fA-F]{32,}\b")
+
+
+def redact(text: object, limit: int = MAX_MESSAGE) -> str:
+    """Bounded, path-free, secret-free single line fit for the owner's screen."""
+    value = str(text or "")
+    value = _SECRETISH.sub("[redacted]", value)
+    value = _ABSPATH.sub("[path]", value)
+    value = _LONGHEX.sub(lambda m: m.group(0)[:12] + "…", value)
+    value = " ".join(value.split())
+    return value[:limit]
+
+
+# Ordered: the first matching probe wins, so specific phrases precede generic ones.
+_PHRASES = (
+    (MISSING_FFMPEG, ("is unavailable; install a local ffmpeg build", "ffmpeg is unavailable",
+                      "ffprobe is unavailable")),
+    (MEDIA_DECODE_FAILED, ("full decode failed", "unsupported or unsafe media container",
+                           "media has no usable video or audio stream", "invalid media duration",
+                           "media content hash mismatch", "sample frame missing")),
+    (VERIFIER_FAILED, ("failed independent verification", "independent media verification",
+                       "duration mismatch", "frame rate mismatch", "audio/video stream start mismatch",
+                       "artifact content hash mismatch", "output changed after",
+                       "media mismatch", "artifact ownership mismatch", "missing render artifact",
+                       "verification receipt")),
+    (RESOURCE_EXHAUSTED, ("insufficient disk space", "disk space exhausted", "exceeded its capture limit",
+                          "exceeds 8 gib limit", "no space left on device", "cannot allocate memory",
+                          "would exceed bounded chunk count", "video admission")),
+    (APPROVAL_REQUIRED, ("approval", "waiting_approval", "review escalation")),
+    (POLICY_DENIED, ("operation denied", "not permitted", "forbidden", "escaped owned storage",
+                     "escaped storage")),
+    (INVALID_PROJECT_STATE, ("revision", "already exists", "unknown ", "invalid ", "requires an",
+                             "must be", "outside", "unsupported ", "project changed")),
+)
+
+
+def classify(exc: BaseException) -> str:
+    """Map a raised failure onto the closed reason-code set. Type first, then text."""
+    if isinstance(exc, (asyncio.TimeoutError, TimeoutError)):
+        return TIMEOUT
+    if isinstance(exc, PermissionError):
+        return POLICY_DENIED
+    if isinstance(exc, MemoryError):
+        return RESOURCE_EXHAUSTED
+    if isinstance(exc, OSError) and exc.errno in (28, 12):        # ENOSPC, ENOMEM
+        return RESOURCE_EXHAUSTED
+    text = str(exc).lower()
+    for code, phrases in _PHRASES:
+        if any(phrase in text for phrase in phrases):
+            return code
+    from .model import Conflict, MissingObject, StudioError
+    if isinstance(exc, (Conflict, MissingObject, StudioError)):
+        return INVALID_PROJECT_STATE
+    return UNKNOWN
+
+
+def describe(exc: BaseException) -> dict:
+    """The full owner-visible failure record: a typed code and a safe message."""
+    code = classify(exc)
+    return {"reason_code": code, "reason": redact(exc) or type(exc).__name__}
