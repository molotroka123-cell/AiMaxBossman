+# ----------------------------------------------------------------- VS-THUMB-01
+class HashSpy:
+    """Counts whole-file SHA-256 calls and the peak number running at once."""
+
+    def __init__(self, monkeypatch):
+        import threading
+        from bcc.video_studio import media as media_module
+        self.calls, self.peak, self._live = 0, 0, 0
+        self._lock = threading.Lock()
+        real = media_module.digest_file
+
+        def counted(path):
+            with self._lock:
+                self.calls += 1
+                self._live += 1
+                self.peak = max(self.peak, self._live)
+            try:
+                return real(path)
+            finally:
+                with self._lock:
+                    self._live -= 1
+
+        monkeypatch.setattr(media_module, "digest_file", counted)
+        monkeypatch.setattr(media_module.MediaLibrary, "resolve",
+                            media_module.MediaLibrary.resolve, raising=False)
+
