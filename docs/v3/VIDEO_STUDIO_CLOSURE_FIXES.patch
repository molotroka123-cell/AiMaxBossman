+"""Closure reproducers for the Video Studio audit (docs/v3/AUDIT_VIDEO_STUDIO.md).
+
+Every test here first FAILED against the audited code and is kept as the
+regression guard for the fix. Nothing is skipped when FFmpeg is present.
+"""
+from __future__ import annotations
+
+import asyncio
+import shutil
+import subprocess
+import uuid
+from pathlib import Path
+
+import pytest
+import sqlalchemy as sa
+
+from bcc.db import task_runs as runs_t
+
+BASE = "/api/video-studio"
+FFMPEG = shutil.which("ffmpeg")
+needs_ffmpeg = pytest.mark.skipif(not FFMPEG or not shutil.which("ffprobe"),
+                                  reason="real FFmpeg binaries required")
+
+
+def op():
+    return uuid.uuid4().hex
+
+
+def fixture_clip(path: Path, colour="blue", seconds=0.4):
+    subprocess.run([FFMPEG, "-v", "error", "-f", "lavfi",
+                    "-i", f"color=c={colour}:s=160x90:r=25:d={seconds}",
+                    "-f", "lavfi", "-i", f"sine=frequency=440:duration={seconds}",
+                    "-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac",
+                    "-shortest", "-y", str(path)], check=True, timeout=60)
+    return path
+
+
+async def run_task(env, task_id):
+    async with env.svc.db.session() as s:
+        run = (await s.execute(sa.select(runs_t).where(runs_t.c.task_id == task_id)
+                               .order_by(runs_t.c.id.desc()))).mappings().first()
+    assert run, "task has no run"
+    await env.svc.engine.execute(run["id"])
+    return (await env.client.get(f"/api/tasks/{task_id}")).json()
+
+
+async def prepared_project(env, tmp_path, monkeypatch):
+    """A real uploaded clip on a real timeline, ready to export."""
+    from types import SimpleNamespace
+    import os
+    import psutil
+    if not os.environ.get("VIDEO_TEST_REAL_MEMORY"):
+        monkeypatch.setattr(psutil, "virtual_memory",
+                            lambda: SimpleNamespace(total=16 * 1024**3, available=8 * 1024**3))
+    clip = fixture_clip(tmp_path / "input.mp4")
+    chat = (await env.client.post(BASE + "/chat",
+                                  json={"text": "Склей эти два видео", "operation_id": op()})).json()
+    pid = chat["project_id"]
+    upload = await env.client.post(BASE + "/media",
+                                   params={"project_id": pid, "filename": "input.mp4",
+                                           "expected_revision": 0, "operation_id": op()},
+                                   content=clip.read_bytes())
+    assert upload.status_code == 200, upload.text
+    await env.client.post(BASE + f"/chat/{chat['task_id']}/run")
+    task = await run_task(env, chat["task_id"])
+    assert task["task"]["status"] == "completed", task
+    project = (await env.client.get(BASE + "/projects/" + pid)).json()
+    return pid, project
+
+
+def watch_gate_subprocesses(env, monkeypatch):
+    """Count subprocesses started while the render completion gate is running."""
+    state = {"active": False, "inside_gate": 0, "gate_ran": False}
+    hooks = env.svc.engine.hooks["gate_completion"]
+    service = env.svc.video_studio
+    index = next(i for i, h in enumerate(hooks)
+                 if getattr(h, "__func__", None) is type(service).render_gate)
+    original = hooks[index]
+
+    async def spy(*args, **kwargs):
+        state["active"], state["gate_ran"] = True, True
+        try:
+            return await original(*args, **kwargs)
+        finally:
+            state["active"] = False
+
+    hooks[index] = spy
+    real = asyncio.create_subprocess_exec
+
+    async def counting(*args, **kwargs):
+        if state["active"]:
+            state["inside_gate"] += 1
+        return await real(*args, **kwargs)
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", counting)
+    return state
+
+
+# ---------------------------------------------------------------- VS-EXPORT-01
+@needs_ffmpeg
+async def test_export_survives_a_gate_that_exceeds_the_fixed_hook_budget(env, tmp_path, monkeypatch):
+    """VS-EXPORT-01: a verified artifact on disk must stay downloadable.
