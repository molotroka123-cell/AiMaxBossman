+def test_discovery_never_selects_candidate_with_non_finite_numbers():
+    bad_values = (float("nan"), float("inf"), float("-inf"), None)
+    fields = ("relevance", "uncertainty", "future_utility", "annoyance_cost", "sensitivity_risk")
+    good = DiscoveryCandidate("good", "Коротко или подробно?", 0.9, 0.9, 0.9, annoyance_cost=0.1)
+    for field in fields:
+        for bad_value in bad_values:
+            kwargs = dict(
+                key="bad",
+                question="Bad?",
+                relevance=0.9,
+                uncertainty=0.9,
+                future_utility=0.9,
+                annoyance_cost=0.1,
+                sensitivity_risk=0.0,
+            )
+            kwargs[field] = bad_value
+            bad = DiscoveryCandidate(**kwargs)
+            for ordered in ([bad, good], [good, bad]):
+                selected = choose_discovery_question(ordered, enabled=True)
+                assert selected is not None and selected.key == "good", (field, bad_value)
+            assert choose_discovery_question([bad], enabled=True) is None, (field, bad_value)
