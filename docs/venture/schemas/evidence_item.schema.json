{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceItem",
  "type": "object",
  "required": [
    "id",
    "claim",
    "source_type",
    "observed_at",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "A_PRIMARY_OFFICIAL",
        "B_PRIMARY_COMMERCIAL",
        "C_DIRECT_MARKET",
        "D_SECONDARY",
        "E_ASSUMPTION"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "fresh_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "VERIFIED",
        "ASSUMPTION",
        "CONFLICTED",
        "STALE",
        "REJECTED"
      ]
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}