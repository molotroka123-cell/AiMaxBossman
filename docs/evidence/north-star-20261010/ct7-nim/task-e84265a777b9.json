 "diff": "diff --git b/command-center/tests/test_terminal_task_paging.py b/command-center/tests/test_terminal_task_paging.py\nnew file mode 100644\nindex 0000000..2ba3c02\n--- /dev/null\n+++ b/command-center/tests/test_terminal_task_paging.py\n@@ -0,0 +1,61 @@\n+import unittest\n+from unittest.mock import Mock, patch\n+from bcc.terminal_cli.cli import list_items\n+\n+class TestTerminalTaskPaging(unittest.TestCase):\n+    def test_list_tasks_paginates_when_limit_over_500(self):\n+        # Mock client that simulates the API behavior\n+        mock_client = Mock()\n+        \n+        # We'll simulate 837 tasks in total, with ids from 1 to 837.\n+        # The API returns tasks in descending order by id, and caps at 500 per request.\n+        \n+        # First request: no before_id, limit=500 (but note: the API will cap the limit we pass to 500)\n+        # We want to return the first 500: ids 837 down to 338\n+        first_batch = [\n+            {\"id\": i, \"status\": \"pending\", \"title\": f\"Task {i}\"}\n+            for i in range(837, 337, -1)  # 837 to 338 inclusive -> 500 items\n+        ]\n+        \n+        # Second request: we will set before_id to the last id from the first batch (which is 338)\n+        # so we get tasks with id < 338, i.e., 337 down to 1 -> 337 tasks\n+        second_batch = [\n+            {\"id\": i, \"status\": \"pending\", \"title\": f\"Task {i}\"}\n+            for i in range(337, 0, -1)  # 337 to 1 inclusive -> 337 items\n+        ]\n+        \n+        # We'll configure the mock to return the appropriate batch based on the params\n+        def mock_get(endpoint, params=None):\n+            if endpoint == \"/api/tasks\":\n+                limit = params.get(\"limit\", 100) if params else 100\n+                before_id = params.get(\"before_id\") if params else None\n+                \n+                if before_id is None:\n+                    # First page\n+                    return first_batch\n+                else:\n+                    # We expect before_id to be 338 for the second page\n+                    self.assertEqual(before_id, 338)\n+                    return second_batch\n+            return []\n+        \n+        mock_client.get.side_effect = mock_get\n+        \n+        # Now call list_tasks with a limit of 1000 (which should trigger pagination)\n+        items = list_items(mock_client, \"tasks\", limit=1000)\n+        \n+        # We should get all 837 tasks\n+        self.assertEqual(len(items), 837)\n+        \n+        # Check that the ids are in descending order (as returned by the API) and without gaps\n+        # Note: the API returns in descending order, and we are concatenating the batches in order.\n+        # So the entire list should be: [837, 836, ..., 1]\n+        expected_ids = list(range(837, 0, -1))\n+        actual_ids = [item[\"id\"] for item in items]\n+        self.assertEqual(actual_ids, expected_ids)\n+        \n+        # Verify that the client.get was called twice\n+        self.assertEqual(mock_client.get.call_count, 2)\n+\n+if __name__ == '__main__':\n+    unittest.main()\n\\ No newline at end of file\n",
