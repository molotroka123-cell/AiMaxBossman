   "command-center/tests/test_autonomy_goals.py": "diff --git a/command-center/tests/test_autonomy_goals.py b/command-center/tests/test_autonomy_goals.py\nindex 38929392..0f20225d 100644\n--- a/command-center/tests/test_autonomy_goals.py\n+++ b/command-center/tests/test_autonomy_goals.py\n@@ -320,6 +320,20 @@ def test_budget_exhaustion_blocks(tmp_path):\n     assert s3.get(\"JEFF-0042\")[\"blocked_reason\"] == \"budget exhausted: time\"\n \n \n+def test_cost_over_limit_blocks(tmp_path):\n+    \"\"\"If max_cost_usd is set and cost exceeds it, goal should be blocked.\"\"\"\n+    clock = Clock()\n+    s = GoalStore(tmp_path, clock=clock)\n+    # create a goal with max_cost_usd = 1.0\n+    s.create(mk(budget=Budget(max_minutes=60, max_agent_turns=5, max_cost_usd=1.0)))\n+    # initial state PROPOSED\n+    assert s.get(\"JEFF-0042\")[\"state\"] == \"PROPOSED\"\n+    # charge cost 5.0 -> should exceed budget and block\n+    result = s.charge(\"JEFF-0042\", cost_usd=5.0)\n+    assert result[\"state\"] == \"BLOCKED\"\n+    assert result[\"blocked_reason\"] == \"budget exhausted: cost\"\n+\n+\n def test_restart_resumes_from_persisted_state(tmp_path):\n     a = GoalStore(tmp_path, clock=Clock())\n     to_review(a)\n"
