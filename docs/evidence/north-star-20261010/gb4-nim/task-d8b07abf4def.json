   "command-center/tests/test_autonomy_goals.py": "diff --git a/command-center/tests/test_autonomy_goals.py b/command-center/tests/test_autonomy_goals.py\nindex 38929392..b6be1918 100644\n--- a/command-center/tests/test_autonomy_goals.py\n+++ b/command-center/tests/test_autonomy_goals.py\n@@ -329,3 +329,18 @@ def test_restart_resumes_from_persisted_state(tmp_path):\n     assert b.transition(\"JEFF-0042\", \"CODEX_REVIEW\", {})[\"state\"] == \"CODEX_REVIEW\"\n     assert b.goal(\"JEFF-0042\") == mk()\n     assert b.journal.verify().ok\n+\n+\n+def test_cost_budget_exceeded_blocks(tmp_path):\n+    \"\"\"If cost exceeds max_cost_usd, goal should be blocked.\"\"\"\n+    clock = Clock()\n+    store = GoalStore(tmp_path, clock=clock)\n+    # goal with max_cost_usd = 1.0\n+    goal = mk(budget=Budget(max_minutes=60, max_agent_turns=5, max_cost_usd=1.0))\n+    store.create(goal)\n+    # initial state PROPOSED\n+    assert store.get(\"JEFF-0042\")[\"state\"] == \"PROPOSED\"\n+    # charge cost 5.0 -> should exceed budget and block\n+    store.charge(\"JEFF-0042\", cost_usd=5.0)\n+    assert store.get(\"JEFF-0042\")[\"state\"] == \"BLOCKED\"\n+    assert store.get(\"JEFF-0042\")[\"blocked_reason\"] == \"budget exhausted: cost\"\n"
  },
