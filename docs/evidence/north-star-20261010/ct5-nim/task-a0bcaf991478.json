 "diff": "diff --git b/command-center/tests/test_terminal_task_paging.py b/command-center/tests/test_terminal_task_paging.py\nnew file mode 100644\nindex 0000000..c5b9f86\n--- /dev/null\n+++ b/command-center/tests/test_terminal_task_paging.py\n@@ -0,0 +1,65 @@\n+import os\n+import sys\n+import unittest\n+from unittest.mock import MagicMock\n+\n+# Add the command-center directory to the sys.path so we can import bcc\n+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))\n+from bcc.terminal_cli.cli import list_items\n+\n+\n+class TestTerminalTaskPaging(unittest.TestCase):\n+    def test_list_tasks_respects_limit_over_500(self):\n+        mock_client = MagicMock()\n+\n+        def mock_get(path, params=None):\n+            before_id = params.get('before_id') if params else None\n+            if before_id is None:\n+                # First page: 500 tasks, ids 1500 down to 1001\n+                return [{'id': i, 'status': 'queued', 'title': f'Task {i}'} for i in range(1500, 1000, -1)]\n+            elif before_id == 1000:\n+                # Second page: 500 tasks, ids 1000 down to 501\n+                return [{'id': i, 'status': 'queued', 'title': f'Task {i}'} for i in range(1000, 500, -1)]\n+            elif before_id == 500:\n+                # Third page: 100 tasks, ids 500 down to 401\n+                return [{'id': i, 'status': 'queued', 'title': f'Task {i}'} for i in range(500, 400, -1)]\n+            else:\n+                return []\n+\n+        mock_client.get.side_effect = mock_get\n+\n+        items = list_items(mock_client, 'tasks', limit=1100)\n+\n+        self.assertEqual(len(items), 1100)\n+        self.assertEqual(mock_client.get.call_count, 3)\n+\n+        calls = mock_client.get.call_args_list\n+        self.assertEqual(calls[0][0], ('/api/tasks',))\n+        self.assertEqual(calls[0][1], {'params': {'limit': 500}})\n+        self.assertEqual(calls[1][0], ('/api/tasks',))\n+        self.assertEqual(calls[1][1], {'params': {'limit': 500, 'before_id': 1001}})\n+        self.assertEqual(calls[2][0], ('/api/tasks',))\n+        self.assertEqual(calls[2][1], {'params': {'limit': 100, 'before_id': 501}})\n+\n+    def test_list_tasks_respects_limit_under_500(self):\n+        mock_client = MagicMock()\n+        mock_client.get.return_value = [\n+            {'id': i, 'status': 'queued', 'title': f'Task {i}'} for i in range(10, 0, -1)\n+        ]\n+        items = list_items(mock_client, 'tasks', limit=10)\n+        self.assertEqual(len(items), 10)\n+        mock_client.get.assert_called_once_with('/api/tasks', params={'limit': 10})\n+\n+    def test_list_tasks_stops_when_no_more_data(self):\n+        mock_client = MagicMock()\n+        mock_client.get.side_effect = [\n+            [{'id': i, 'status': 'queued', 'title': f'Task {i}'} for i in range(50, 0, -1)],\n+            []\n+        ]\n+        items = list_items(mock_client, 'tasks', limit=100)\n+        self.assertEqual(len(items), 50)\n+        self.assertEqual(mock_client.get.call_count, 2)\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()\n\\ No newline at end of file\n",
