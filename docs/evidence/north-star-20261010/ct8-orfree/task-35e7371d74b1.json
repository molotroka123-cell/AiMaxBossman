 "diff": "diff --git b/command-center/tests/test_terminal_task_paging.py b/command-center/tests/test_terminal_task_paging.py\nnew file mode 100644\nindex 0000000..f3ec5e0\n--- /dev/null\n+++ b/command-center/tests/test_terminal_task_paging.py\n@@ -0,0 +1,57 @@\n+import pytest\n+from unittest.mock import MagicMock, patch\n+import os\n+import sys\n+\n+# Add the command-center directory to the path so we can import the bcc package\n+sys.path.insert(0, os.path.dirname(os.path.dirname(__file__)))\n+from bcc.terminal_cli.cli import list_items\n+\n+def test_list_tasks_paginates_when_limit_exceeds_api_max():\n+    # Simulate API that returns at most 500 tasks per request\n+    def mock_get(path, params=None):\n+        # params may contain 'limit' and we simulate that the API ignores limit > 500\n+        # and returns min(limit, 500) tasks, but we also simulate total tasks = 837\n+        # We'll use offset to paginate\n+        offset = params.get('offset', 0) if params else 0\n+        limit = params.get('limit', 500) if params else 500\n+        # The API enforces a max limit of 500 per request\n+        effective_limit = min(limit, 500)\n+        # Total tasks available\n+        total_tasks = 837\n+        start = offset\n+        end = min(offset + effective_limit, total_tasks)\n+        if start >= total_tasks:\n+            return []\n+        # Generate dummy tasks\n+        tasks = [{\"id\": i, \"status\": \"queued\", \"title\": f\"Task {i}\"} for i in range(start, end)]\n+        return tasks\n+\n+    with patch('bcc.terminal_cli.cli.Client') as MockClient:\n+        mock_client = MagicMock()\n+        mock_client.get.side_effect = mock_get\n+        MockClient.return_value = mock_client\n+\n+        # Call list_tasks with limit=1000\n+        items = list_items(mock_client, \"tasks\", limit=1000)\n+\n+        # We expect to get all 837 tasks\n+        assert len(items) == 837\n+        # Check that the client.get was called multiple times\n+        # First call: offset=0, limit=500 (or 1000? but we will adjust in the function)\n+        # Actually, we don't know how the function will call it yet.\n+        # We'll just check that it was called more than once.\n+        assert mock_client.get.call_count >= 2\n+        # We can also check the params of the calls\n+        # For simplicity, we'll just check that offset increases\n+        calls = mock_client.get.call_args_list\n+        # First call should have offset=0\n+        first_call_params = calls[0][1].get('params', {})\n+        assert first_call_params.get('offset', 0) == 0\n+        # Second call should have offset=500\n+        second_call_params = calls[1][1].get('params', {})\n+        assert second_call_params.get('offset', 0) == 500\n+        # Third call should have offset=1000? but we only have 837 tasks, so third call might not happen\n+        # Actually, with 837 tasks and page size 500, we need two calls: 0-500 and 500-837\n+        # So we expect exactly two calls\n+        assert mock_client.get.call_count == 2\n\\ No newline at end of file\n",
