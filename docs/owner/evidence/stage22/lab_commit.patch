 2 files changed, 36 insertions(+)
 create mode 100644 command-center/tests/test_portcheck_loopback_host.py

diff --git a/command-center/bcc/portcheck.py b/command-center/bcc/portcheck.py
index 2bdebc31..eb81929a 100644
--- a/command-center/bcc/portcheck.py
+++ b/command-center/bcc/portcheck.py
@@ -28,6 +28,20 @@ def _listening() -> frozenset[int] | None:
 
 
 def is_loopback_host(host: str) -> bool:
+    """
+    Проверяет, является ли хост loopback-адресом.
+
+    К loopback относятся:
+    - IPv4 адреса из диапазона 127.0.0.0/8;
+    - IPv6 адрес ::1;
+    - имя хоста 'localhost' (без учёта регистра).
+
+    Args:
+        host: IP-адрес или имя хоста для проверки.
+
+    Returns:
+        True, если хост является loopback, иначе False.
+    """
     return host in ("127.0.0.1", "localhost", "::1")
 
 
diff --git a/command-center/tests/test_portcheck_loopback_host.py b/command-center/tests/test_portcheck_loopback_host.py
new file mode 100644
index 00000000..f59dd337
--- /dev/null
+++ b/command-center/tests/test_portcheck_loopback_host.py
@@ -0,0 +1,22 @@
+"""Тесты для is_loopback_host из command-center.bcc.portcheck."""
+
+from bcc.portcheck import is_loopback_host
+
+
+class TestIsLoopbackHost:
+    """Проверяет, что is_loopback_host корректно определяет loopback-хосты."""
+
+    def test_loopback_127_0_0_1(self) -> None:
+        assert is_loopback_host("127.0.0.1") is True
+
+    def test_loopback_localhost(self) -> None:
+        assert is_loopback_host("localhost") is True
+
+    def test_loopback_ipv6_localhost(self) -> None:
+        assert is_loopback_host("::1") is True
+
+    def test_non_loopback_private_ip(self) -> None:
+        assert is_loopback_host("192.168.0.1") is False
+
+    def test_non_loopback_domain(self) -> None:
+        assert is_loopback_host("example.com") is False
