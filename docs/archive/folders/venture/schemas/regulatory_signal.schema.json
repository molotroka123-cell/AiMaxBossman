{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegulatorySignal",
  "type": "object",
  "required": [
    "id",
    "authority",
    "jurisdiction",
    "status",
    "observed_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "instrument": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "legislative_stage": {
      "type": "string"
    },
    "technical_stage": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_segments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "primary_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}