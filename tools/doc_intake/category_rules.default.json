    {
      "name": "tech",
      "keywords": ["техническое задание", "тз", "спецификац", "архитектур", "api", "sdk", "протокол", "схема данных",
                   "datasheet", "specification", "architecture", "python", "docker", "kubernetes", "database", "schema",
                   "firmware", "endpoint"]
    }
  ]
