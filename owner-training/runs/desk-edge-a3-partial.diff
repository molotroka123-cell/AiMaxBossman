+# ------------------------------------------- автоперезапускающийся браузер (Edge)
+
+def _fake_relaunching_browser(profile_dir: Path) -> tuple[str, Path]:
+    """Скрипт-браузер, воспроизводящий поведение msedge.exe на занятый профиль.
+
+    Запущенный нами процесс стартует детаченое «окно» (отдельный PID) с тем же
+    ``--user-data-dir`` и сам выходит кодом 0 почти мгновенно. Именно эту схему
+    воспроизводит настоящий Edge: PID, который мы запустили, — не окно; окно
+    держит другой процесс с тем же профилем.
+
+    Живое «окно» — отдельный python-процесс, который:
+      * держит профиль (его cmdline содержит ``--user-data-dir=<профиль>``);
+      * пишет свой PID в ``<prof>.pid`` — тест по нему убивает процесс, чтобы
+        не оставлять хвостов и чтобы ``profile_holders`` стало пусто к концу;
+      * живёт долго (sleep 600), но тест его убивает — процесс не живёт дольше прогона.
+
+    Возвращает ``(путь к скрипту, путь к pid-файлу)``.
+    """
+    profile = Path(profile_dir)
+    profile.mkdir(parents=True, exist_ok=True)
+    script = profile.parent / "_fake_browser.py"
+    pidfile = profile.parent / "_fake_browser.pid"
+    # repr() экранирует обратные слеши в пути (Windows), иначе сгенерированный
+    # скрипт не соберётся: '\U' в строке — недопустимый unicode-escape.
+    prof_lit = repr(str(profile))
+    pidfile_lit = repr(str(pidfile))
+    script.write_text(
+        "import os, subprocess, sys, time\n"
+        f"subprocess.Popen([sys.executable, '-c',\n"
+        f"    'import sys, time, os\\n' +\n"
+        f"    f'open({pidfile_lit}, \\"w\\").write(str(os.getpid()))\\n' +\n"
+        f"    f'print(\\"--user-data-dir=" + {prof_lit} + \\"\\", flush=True)\\n' +\n"
+        f"    'time.sleep(600)'],\n"
+        f"  creationflags=getattr(subprocess, 'DETACHED_PROCESS', 0) |"
+        f" getattr(subprocess, 'CREATE_NEW_PROCESS_GROUP', 0))\n"
+        "sys.exit(0)\n",
+        encoding="utf-8")
+    return str(script), pidfile
+
+
+def _kill_fake_browser(pidfile: Path) -> None:
+    """Убить живой «браузер» по его pid-файлу (честно, по PID)."""
+    try:
+        pid = int(pidfile.read_text(encoding="utf-8").strip())
+    except (OSError, ValueError):
+        return
+    try:
+        os.kill(pid, 9)
+    except (OSError, ProcessLookupError):
+        pass
+    # Дать ядру снять PID, чтобы profile_holders вернул [].
+    deadline = time.monotonic() + 3.0
+    while time.monotonic() < deadline and desktop.profile_holders(_last_profile):
+        time.sleep(0.1)
+
+
+def test_self_relaunching_browser_is_treated_as_open_window(tmp_path, monkeypatch):
+    """Edge-схема: запущенный PID умер кодом 0, но живой браузер держит профиль.
+
+    Лаунчер обязан считать окно открытым и ждать, пока владелец закроет окно
+    (тот живой браузер), а не возвращаться сразу.
+    """
+    global _last_profile
+    profile = tmp_path / "prof"
+    _last_profile = profile
+    script, pidfile = _fake_relaunching_browser(profile)
+
+    def fake_open(browser, url, profile_dir, *, extra=(), window_size="1440,900"):
+        Path(profile_dir).mkdir(parents=True, exist_ok=True)
+        return subprocess.Popen([sys.executable, script], stdin=subprocess.DEVNULL)  # noqa: S603
+
+    monkeypatch.setattr(desktop, "open_window", fake_open)
+    started = time.monotonic()
+
+    code = desktop.launch_window("/bin/true", "http://127.0.0.1:1/", profile, timeout=5)
+
+    elapsed = time.monotonic() - started
+    # Запущенный PID умер за ~0.1 с, но живой «браузер» держал профиль.
+    # Лаунчер должен был дождаться его (grace ~3 c), а не вернуться мгновенно.
+    assert code == 0, "окно, переданное браузеру, должно вернуться кодом 0"
+    assert elapsed >= 2.0, f"вернулись через {elapsed:.2f} c — не ждали живого браузера"
+    # Живой «браузер» ещё на месте: мы его не убивали, только ждали.
+    assert desktop.profile_holders(profile), "живой браузер с тем же профилем не найден"
+    _kill_fake_browser(pidfile)
+
+
+def test_quick_exit_without_profile_holder_returns_own_code(tmp_path, monkeypatch):
+    """Если после быстрого кода 0 никто не держит профиль — сегодняшнее поведение.
+
+    Лаунчер не обязан ждать вечно: без живого браузера на профиле он
+    возвращается кодом 0 (с ограниченным grace-окном), и вызывающий разбирает
+    быстрый исход как краш (диагностика + код возврата).
+    """
+    profile = tmp_path / "prof"
+
+    def fake_open(browser, url, profile_dir, *, extra=(), window_size="1440,900"):
+        Path(profile_dir).mkdir(parents=True, exist_ok=True)
+        return subprocess.Popen([sys.executable, "-c", "raise SystemExit(0)"],  # noqa: S603
+                                stdin=subprocess.DEVNULL)
+
+    monkeypatch.setattr(desktop, "open_window", fake_open)
+    started = time.monotonic()
+
+    code = desktop.launch_window("/bin/true", "http://127.0.0.1:1/", profile, timeout=5)
+
+    elapsed = time.monotonic() - started
+    assert code == 0, "код 0 без живого браузера обязан дойти до вызывающего"
+    # Без живого браузера лаунчер не должен ждать 5 с дедлайна: grace-окно
+    # ограничено (3 c), и вызывающий успевает показать диагностику краша.
+    assert elapsed < 4.0, f"ждали {elapsed:.2f} c без живого браузера — не должно быть"
+    assert desktop.profile_holders(profile) == []
