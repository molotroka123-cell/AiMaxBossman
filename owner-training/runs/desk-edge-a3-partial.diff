+def profile_holders(profile_dir: Path) -> list[int]:
+    """PID живых процессов, чей командный ряд использует ``--user-data-dir=<профиль>``.
+
+    Chromium-браузеры (Edge/Chrome) при запуске на занятый профиль сами передают
+    окно уже запущенному браузеру и завершают тот PID, который мы запустили,
+    кодом 0: живой процесс — другой, и это он держит окно. Профиль — единственный
+    надёжный маркер «это наше окно»: PID, имя процесса и argv окна не переживают
+    передачу, а каталог профиля — да.
+
+    Только чтение: процесс не убиваем и не трогаем. Если psutil недоступен
+    или процесс исчез в момент чтения — пустой список (окно «не найдено»).
+    """
+    import psutil
+
+    target = f"--user-data-dir={Path(profile_dir)}"
+    pids: list[int] = []
+    for p in psutil.process_iter(["cmdline"]):
+        try:
+            cmdline = p.info.get("cmdline") or []
+        except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess, OSError):
+            continue
+        if any(a == target for a in cmdline):
+            pids.append(p.pid)
+    return pids
+
