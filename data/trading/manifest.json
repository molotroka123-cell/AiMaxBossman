{
  "corpus": "bossman-trader-apprentice-btc-orderflow",
  "version": "1.2.1",
  "updated_at": "2026-09-09",
  "load_order": [
    "docs/trading/LOCAL_MODEL_SYSTEM_PROMPT.md",
    "docs/trading/BTC_ORDERFLOW_PLAYBOOK.md",
    "data/trading/btc_orderflow_rules_v1.json",
    "data/trading/btc_casebook_2026_09.jsonl"
  ],
  "deterministic_engine": "learning/trader_apprentice.py",
  "youtube_teacher": {
    "tool": "tools/youtube_trader_ingest_auto.py",
    "visual_core": "tools/youtube_trader_ingest.py",
    "docs": "docs/trading/YOUTUBE_TEACHER_INGEST.md",
    "input_contract": "one public youtube.com or youtu.be URL",
    "output_root": "data/trading/youtube_inbox/<video_id>/",
    "status": "UNVERIFIED_INGEST",
    "requires": [
      "yt-dlp",
      "ffmpeg",
      "OpenAI-compatible local multimodal model"
    ],
    "optional_when_youtube_captions_missing": [
      "OpenAI-compatible local audio/transcriptions model"
    ],
    "auto_route_trading_youtube_urls": true,
    "never_require_owner_transcript_or_screenshots": true,
    "promotion_requires_independent_verification": true
  },
  "tests": [
    "tests/test_trader_apprentice.py",
    "tests/test_youtube_trader_ingest.py",
    "tests/test_youtube_trader_ingest_auto.py"
  ],
  "retrieval_hints": [
    "btc",
    "trading",
    "trader apprentice",
    "youtube teacher",
    "video ingest",
    "youtube url",
    "local asr",
    "coinwise",
    "k1m6a",
    "cvd",
    "open interest",
    "oi",
    "liquidations",
    "dval",
    "dpoc",
    "dvah",
    "dopen",
    "deleveraging",
    "absorption",
    "reclaim",
    "sweep",
    "short covering",
    "leverage expansion"
  ],
  "runtime_policy": {
    "analysis_only": true,
    "autonomous_order_execution": false,
    "missing_metrics": "UNKNOWN",
    "require_source_and_instrument_tags": true,
    "require_same_series_for_cvd_oi_delta": true,
    "separate_cme_and_execution_market_prices": true,
    "never_invent_live_values": true,
    "youtube_teacher_is_untrusted": true,
    "raw_teacher_claims_are_not_training_truth": true
  },
  "recommended_runtime_sequence": [
    "If the owner supplies a trading YouTube URL, invoke tools/youtube_trader_ingest_auto.py automatically.",
    "Fetch YouTube captions automatically; if absent, attempt configured local ASR; if ASR is unavailable, continue with visual parsing and mark speech missing.",
    "Sample the video into timestamped frames.",
    "Use the local multimodal model to extract factual observations with unreadable values as UNKNOWN/null.",
    "Load the previous compatible Snapshot from the same source/instrument series.",
    "Run learning.trader_apprentice.analyze(previous, current, levels).",
    "Attach future in-video price outcomes when later observations exist.",
    "Store raw YouTube teacher episodes as UNVERIFIED and never auto-promote commentary to canonical truth.",
    "Retrieve the verified playbook/rules for explanation and scenario construction.",
    "Do not place an order without a separate explicit execution authorization layer."
  ]
}
