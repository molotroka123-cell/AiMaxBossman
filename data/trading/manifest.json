  "recommended_runtime_sequence": [
    "Extract current screenshot/live observation into a structured Snapshot.",
    "Load the previous compatible Snapshot from the same series.",
    "Run learning.trader_apprentice.analyze(previous, current, levels).",
    "Retrieve the playbook/rules for explanation and scenario construction.",
    "Return market-state matrix, regime, evidence, levels, trigger/invalidation, missing data and confidence.",
