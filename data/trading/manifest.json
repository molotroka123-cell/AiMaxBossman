  "load_order": [
    "docs/trading/LOCAL_MODEL_SYSTEM_PROMPT.md",
    "docs/trading/BTC_ORDERFLOW_PLAYBOOK.md",
    "data/trading/btc_orderflow_rules_v1.json",
