  ],
  "deterministic_engine": "learning/trader_apprentice.py",
  "tests": "tests/test_trader_apprentice.py",
  "retrieval_hints": [
    "btc",
    "trading",
    "trader apprentice",
    "coinwise",
    "k1m6a",
    "cvd",
    "open interest",
    "oi",
    "liquidations",
    "dval",
