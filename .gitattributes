# Сгенерированные ассеты приложения обязаны быть побайтово одинаковыми на всех
# платформах. Git не должен их переписывать: чекаут на Windows с autocrlf
# превращал LF в CRLF внутри icon.svg, и проверка канонной иконки падала на
# файле, который рисует ту же картинку.
command-center/ui/icons/** binary
command-center/ui/icon.svg -text
bossman-core/ui/icon.svg -text

# Доказательства для bossman_critical_errors.json: sha256 должен совпадать побайтово.
docs/owner/evidence/** -text

# Замок сборки Windows сверяется по sha256 побайтово (windows_bundle_lock.json).
# Чекаут с autocrlf превращал LF в CRLF, и замок «ломался» на машине владельца.
tools/windows_bundle_lock.txt -text
tools/windows_bundle_build_tools.txt -text

# Комплект владельческого прогона и вендоренные навыки сверяются по sha256/длине
# побайтово (PREPARATION_FILE_CHECKS.json, voltagent-agent-skills.lock.json):
# чекаут с autocrlf ломал их на машине владельца.
docs/v8/owner-final-run/** -text
.agents/skills/** -text

# Imported skills are byte-identical to their pinned upstream (sha256 in provenance.json):
# no whitespace rewrite or hygiene check on them, and no EOL conversion.
command-center/bcc/skills_catalog/** -whitespace -text
