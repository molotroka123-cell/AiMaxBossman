{
  "schema": "bossman.v1.5.self-improvement/1",
  "goal": "autonomous Bossman loop: task failure -> self-repair candidate -> executable verifier -> lesson -> unseen transfer, with owner supervision from Telegram/UX/CMD",
  "controller": "bossman",
  "router": "jev",
  "external_auditor": "bootstrap_then_optional_red_team_only",
  "codex_role": "owner_integrator_only",
  "claude_role": "not_required_for_routine_loop",
  "student": {
    "preferred_model": "inclusionai/ling-3.0-flash-fin:free",
    "fallback_mode": "bossman_router",
    "use_memory": true,
    "use_skills": true,
    "use_verified_recipes": true
  },
  "teacher_swarm": [
    "nvidia/nemotron-3-ultra-550b-a55b:free",
    "nvidia/nemotron-3-ultra-550b-a55b:free",
    "nvidia/nemotron-3-ultra-550b-a55b:free"
  ],
  "finalizer": {
    "model": "z-ai/glm-5.3-flash",
    "paid": true,
    "max_calls_per_campaign": 4,
    "max_usd_per_campaign": 0.5,
    "only_after_verified_blocker": true
  },
  "provider_pool": {
    "config": "config/v1.5/provider-pool.json",
    "minimum_ready_zero_cost_providers": 1,
    "allow_owner_onboarding": true,
    "auto_create_accounts": false,
    "allow_quota_evasion": false,
    "target_ready_zero_cost_providers": 2,
    "capacity_expansion_nonblocking": true,
    "onboarding_command": "python tools/v15_provider_pool.py onboarding"
  },
  "evolution": {
    "suite": "config/evolution/owner-v1.5-self-improve.json",
    "backend": "bossman_coding",
    "executor": "host",
    "max_cycles": 8,
    "attempt_minutes": 35,
    "total_hours": 8,
    "max_retries_per_task": 2,
    "max_consecutive_failures": 3,
    "max_disk_mb": 8192,
    "max_rss_mb": 24576,
    "min_free_ram_mb": 16384,
    "max_usd": 0.5,
    "attempt_usd": 0.1
  },
  "promotion": {
    "model_done_is_pass": false,
    "requires_deterministic_or_executable_verifier": true,
    "requires_unseen_transfer": true,
    "requires_security_non_regression": true,
    "minimum_shadow_runs": 20,
    "owner_promotion_required": true,
    "auto_write_stable": false
  },
  "trading": {
    "execution": "OFF",
    "paper_only": true,
    "teacher_claims_start": "UNVERIFIED",
    "promotion_via_trading_memory_only": true
  },
  "stop": {
    "durable": true,
    "campaign_stop_file": "STOP",
    "provider_breaker_on_repeated_failures": true
  },
  "owner_supervisor": "telegram_ux_cmd",
  "runtime_repair": {
    "failure_inbox": "v1.5/self-repair/inbox.jsonl",
    "auto_create_local_candidate_branch": true,
    "candidate_prefix": "bossman-self-repair/",
    "requires_green_executable_test": true,
    "requires_unseen_transfer_before_promotion": true,
    "auto_write_stable": false
  },
  "aster_role": "launch_self_improvement_then_detach",
  "exit_gate": {
    "status": "ASTER_DETACHED_CONTINUITY_PASS",
    "requires_campaign_started": true,
    "requires_bossman_status_without_external_auditor": true,
    "requires_one_verified_or_rejected_scientific_cycle": true,
    "requires_restart_continuity": true,
    "requires_owner_controls_without_aster_or_codex": true
  },
  "self_improvement_north_star": {
    "routine_external_coder_dependency": false,
    "aster_required_after_bootstrap": false,
    "codex_required_after_bootstrap": false,
    "target": "Bossman selects resources, repairs, verifies, learns, retries, and reports using its own bounded runtime"
  },
  "model_routing_stack": {
    "config": "config/v1.5/model-routing-stack.json",
    "refresh_owner_run_first": true,
    "live_report": "owner-run/v1.5/model-routing-stack-live.json",
    "no_silent_alias_substitution": true
  },
  "bootstrap": {
    "order": [
      "aster_refresh_model_routing_stack",
      "prove_one_coding_route",
      "prove_one_independent_verifier",
      "prove_jev_stop_budget_isolation",
      "start_self_improvement_campaign",
      "parallel_provider_expansion",
      "parallel_youtube_learning",
      "parallel_owner_acceptance"
    ],
    "start_as_soon_as_minimum_safe_path_exists": true,
    "optional_specialists_do_not_block_start": true,
    "provider_onboarding_does_not_block_start_when_capacity_exists": true
  }
}
