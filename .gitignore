# Рабочие каталоги
.bossman-v2-pack/
_staging/

# Исходные паки и архивы НЕ живут в корне отслеживаемого дерева.
# Правило намеренно привязано к корню (`/`), а не к любому уровню: ассеты
# приложений и тестовые фикстуры-архивы должны оставаться под контролем версий.
/*.zip
# Кроме одного: пакет спецификации Social Farm — не транспортный архив, а
# ВХОД двух наборов проверок. `test_browser_selectors.py` и
# `test_browser_states.py` читают из него схему selector-pack. Измерено, а не
# предположено: со спекой 43 passed, без неё 3 failed, 39 passed, 1 skipped.
# Он выглядит ровно как корневой ZIP-мусор и попадает под правило выше —
# отсюда явное исключение, чтобы следующая чистка не удалила вход тестов,
# приняв его за хвост.
!/BOSSMAN_SOCIAL_FARM_APP4_TECH_SPEC_V1_1.zip
/*.tar
/*.tar.gz
/*.tgz
/*.7z
/*.rar

# Случайные дампы изображений в корне. Справочные картинки кладутся осознанно
# в docs/reference-images/ и туда это правило не достаёт.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.bmp
/*.pdf

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Данные приложений и рантайма (никогда не коммитятся)
/data/
apps/*/data/
*.sqlite
*.sqlite3
*.db
.env
!/.env.example
!apps/*/.env.example
!solana_volume_suite/.env.example
secret.key
*wallets_encrypted*.json

# Рабочие копии репозитория, которые создаёт харнесс под изолированных агентов.
# Это дубликаты того же дерева (сотни мегабайт), а не содержимое проекта.
# Правило намеренно узкое: если в .claude/ появится настройка проекта или
# скилл, они останутся под контролем версий.
.claude/worktrees/

# Acceptance live-run artifacts: binaries and personal media stay local
.audit-learning-guard-*/
artifacts/video_factory/

# Learning corpus is tracked (canonical VERIFIED/failed cases)
!/data/
/data/*
!/data/learning/
# Trader Apprentice corpus is evidence the local model reads, not runtime
# state: the rule set, the September casebook and their manifest belong in
# review like any other reviewed artefact. Tracked by an explicit exception
# rather than by force-adding past the rule above, so the next person can
# see it was meant.
!/data/trading/

# deterministic repo-map cache (tools/context_slice.py)
.bossman-cache/
build/
astra-security-results/
.coverage
.coverage.*
/.audit-work/

# Состояние прогонов на машине владельца: корпус реальных нагрузок, отчёты
# доктора и вечерней приёмки. Это НАБЛЮДЕНИЯ конкретной машины, а не исходники;
# в релизные улики они попадают явным копированием, а не автокоммитом.
/.bossman-state/
/real_workload_audit.json
/real_workload_audit.md
/doctor.json
.venv-conv/
.venv-oh/

# Локальная поставка, собираемая tools/build_local_bundle.py
/dist/
