# Рабочие каталоги
.bossman-v2-pack/
_staging/

# Исходные паки и архивы НЕ живут в корне отслеживаемого дерева.
# Правило намеренно привязано к корню (`/`), а не к любому уровню: ассеты
# приложений и тестовые фикстуры-архивы должны оставаться под контролем версий.
/*.zip
/*.tar
/*.tar.gz
/*.tgz
/*.7z
/*.rar

# Случайные дампы изображений в корне. Справочные картинки кладутся осознанно
# в docs/reference-images/ и туда это правило не достаёт.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.bmp
/*.pdf

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Данные приложений и рантайма (никогда не коммитятся)
/data/
apps/*/data/
*.sqlite
*.sqlite3
*.db
.env
!/.env.example
!apps/*/.env.example
!solana_volume_suite/.env.example
secret.key
*wallets_encrypted*.json

# Рабочие копии репозитория, которые создаёт харнесс под изолированных агентов.
# Это дубликаты того же дерева (сотни мегабайт), а не содержимое проекта.
# Правило намеренно узкое: если в .claude/ появится настройка проекта или
# скилл, они останутся под контролем версий.
.claude/worktrees/

# Acceptance live-run artifacts: binaries and personal media stay local
.audit-learning-guard-*/
artifacts/video_factory/

# Learning corpus is tracked (canonical VERIFIED/failed cases)
!/data/
/data/*
!/data/learning/

# deterministic repo-map cache (tools/context_slice.py)
.bossman-cache/
build/
astra-security-results/
.coverage
.coverage.*
