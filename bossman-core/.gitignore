.env
__pycache__/
*.egg-info/
.pytest_cache/
# Рантайм-каталоги проектов и рабочей области (ROOT/projects, ROOT/workspace).
# Якорим ведущим слэшем: без него правило ловило и пакет-исходник
# bossman/projects/ (planner/runner/plan/router) — он не попадал в git.
/projects/
/workspace/

# ЭТАП 3 — AI Gateway: боевой конфиг может нести ключи клиентов/провайдеров.
# В git живёт только config/gateway.example.yaml с плейсхолдерами.
config/gateway.yaml
gateway.yaml
# Context & Memory Engine (ЭТАП 2.222) runtime — SQLite/WAL индекс и вектора не в git
**/_context/
context.db
context.db-wal
context.db-shm
*.db-wal
*.db-shm

# Bossman ComputerUse runtime — профили, cookies и загрузки живых сессий
.browser-profiles/
browser-profiles/
**/browser-profile/
**/browser-profiles/
**/.auth/
playwright/.auth/
**/downloads/
