# Bossman Core — для запуска БЕЗ docker (разработка на ноутбуке).
# В бою всё приходит из compose.core.yaml + .env инфраструктуры.

LITELLM_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=sk-CHANGE_ME
LLAMA_SWAP_URL=http://127.0.0.1:8080

# ЭТАП 3 — AI Gateway. Пусто => ядро ходит к моделям напрямую через LiteLLM
# (текущее поведение). Заданный URL включает единую точку выхода через Gateway;
# ключ ядра генерируется отдельно и хранится ТОЛЬКО здесь/в секрет-менеджере.
# Адрес обязан содержать версию: клиент клеит {URL}/chat/completions, и адрес
# без /v1 превращает каждый запрос в 404 (живой прогон 20260906).
BOSSMAN_GATEWAY_URL=
BOSSMAN_GATEWAY_CORE_KEY=
BOSSMAN_DATABASE_URL=postgresql://bossman:CHANGE_ME@127.0.0.1:5432/bossman
REDIS_URL=redis://127.0.0.1:6379/0

SANDBOX_MODE=docker             # docker = контейнер без сети; local = subprocess БЕЗ изоляции
# local сам по себе не исполняет: команду агента на хосте без изоляции включает
# только явный флаг ниже — раскомментируйте его вместе с SANDBOX_MODE=local
# ТОЛЬКО на машине разработчика, никогда в бою.
# BOSSMAN_UNSAFE_LOCAL_EXEC=1
CORE_PORT=8700

# Доступ к маршрутам ядра — ТОЛЬКО через устройства Stage 6 (единый auth-слой,
# никаких отдельных ключей ядра). Провижининг первого устройства:
#   python scripts/bootstrap_remote_device.py  — выдаст device-токен (rcd_...)
# Скоупы: chat (задачи/проекты), events (шина), approve (подтверждения),
# admin (ресурсы/песочница/dev-factory/AI Lab). Без токена маршруты закрыты.

# ключи LiteLLM per-агент: ./scripts/create-agent-key.sh (в bossman-infra)
LITELLM_KEY_ANALYST=
LITELLM_KEY_CODER=
LITELLM_KEY_FRESH_VIBES=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Опционально: доп. привязка Telegram-пользователей к approval-кнопкам
# (сверх webhook-секрета и привязки к чату) — список id через запятую.
TELEGRAM_ALLOWED_USER_IDS=

# Cost Governor + Notification Dispatcher — обе БД под workspace/, не в git.
# Пустые лимиты НИЧЕГО не лимитируют (никакой лимит не изобретается) — их
# осознанно задаёт владелец через /budget/policies (admin) либо этими env.
BOSSMAN_NOTIFICATION_DB=
BOSSMAN_COST_DB=
BOSSMAN_BUDGET_RUN_USD=
BOSSMAN_BUDGET_TASK_USD=
BOSSMAN_BUDGET_PROJECT_USD=
BOSSMAN_BUDGET_DAILY_USD=
BOSSMAN_BUDGET_WARNING_FRACTION=0.80
BOSSMAN_BUDGET_HARD_ACTION=stop

HIGGSFIELD_API_URL=
HIGGSFIELD_API_KEY=

# --- Облачные провайдеры моделей -------------------------------------------
# Ключи живут ТОЛЬКО здесь (или в окружении процесса), никогда в gateway.yaml и
# никогда в git: в конфиге лежит только ИМЯ переменной. Заданный ключ сам
# поднимает бэкенд в Gateway — правка yaml для этого не нужна. Пустой ключ =
# провайдер недоступен, и это штатное состояние, а не ошибка запуска.
# Проверка: bossman models list --provider openrouter | GET /health/openrouter
# Это же имя читают Command Center (провайдер и плагин) и video_factory. Старое
# BOSSMAN_OPENROUTER_API_KEY тоже читается; два РАЗНЫХ значения — предупреждение
# доктора, а не молчаливый выбор одного из них.
OPENROUTER_API_KEY=
# База БЕЗ /v1: версию Gateway добавляет сам (иначе выйдет /api/v1/v1/models).
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Модель через OpenRouter адресуется как openrouter/<id>, например
# openrouter/z-ai/glm-5.3-flash — префикс и есть выбор провайдера.

# GLM напрямую у Z.ai (второй маршрут к той же модели).
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL_ID=glm-5.3
